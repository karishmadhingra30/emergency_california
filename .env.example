# Eval harness config. Copy to .env — never commit real keys.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# AWS: ALWAYS the 'emergency' profile (personal account 640309151867).
# The machine's default profile is a shared collaborator account — never use it.
AWS_PROFILE=emergency
AWS_REGION=us-east-2
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
